<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Transparent safety area -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
        </shape>
    </item>

    <!-- True circular NMIX surface -->
    <item
        android:left="7dp"
        android:top="7dp"
        android:right="7dp"
        android:bottom="7dp">
        <shape android:shape="oval">
            <solid android:color="@color/nmix_icon_green"/>
        </shape>
    </item>

    <!-- NMIX artwork kept safely inside circle -->
    <item
        android:left="22dp"
        android:top="22dp"
        android:right="22dp"
        android:bottom="22dp"
        android:drawable="@drawable/nmix_icon_foreground"/>

</layer-list>
