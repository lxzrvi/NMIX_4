<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style
        name="Theme.NMIX"
        parent="android:style/Theme.Material.NoActionBar">

        <item name="android:fontFamily">sans</item>

        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>

        <!--
            Neutral dark launch surface prevents the
            system Light theme from producing a white
            startup frame before Compose is ready.
        -->
        <item name="android:windowBackground">#0D1110</item>
        <item name="android:colorBackground">#0D1110</item>

        <item name="android:statusBarColor">#0D1110</item>
        <item name="android:navigationBarColor">#0D1110</item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Keep launch preview opaque. -->
        <item name="android:windowDisablePreview">false</item>

        <!-- Prevent translucent activity frames. -->
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowIsFloating">false</item>

        <!-- No platform window transition flash. -->
        <item name="android:windowAnimationStyle">@null</item>

    </style>

</resources>
