<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style
        name="Theme.NMIX"
        parent="android:style/Theme.Material.NoActionBar">

        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>

        <!-- Same exact first frame as Compose loading screen -->
        <item name="android:windowBackground">@color/nmix_launch_background</item>
        <item name="android:colorBackground">@color/nmix_launch_background</item>
        <item name="android:statusBarColor">@color/nmix_launch_background</item>
        <item name="android:navigationBarColor">@color/nmix_launch_background</item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowAnimationStyle">@null</item>

    </style>

</resources>
